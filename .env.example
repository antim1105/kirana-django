# Copy this file to `.env` and edit it, or export these variables directly.
# `manage.py` does not read `.env` on its own — use your shell, systemd,
# docker-compose or a tool like direnv to load it.

# --- Core ---------------------------------------------------------------
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-before-you-deploy
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed only when serving over HTTPS behind a domain:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://rates.myshop.in
# DJANGO_SECURE_SSL_REDIRECT=True

DJANGO_TIME_ZONE=Asia/Kolkata

# --- Database -----------------------------------------------------------
# sqlite (default), postgresql or mysql
DATABASE_ENGINE=sqlite

# Where the SQLite file lives. Relative paths are resolved against the
# project directory. The default is db.sqlite3 next to manage.py.
# SQLITE_PATH=db.sqlite3

# The settings below apply to postgresql and mysql only.
# DATABASE_NAME=kirana
# DATABASE_USER=kirana
# DATABASE_PASSWORD=
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5432

# --- Access -------------------------------------------------------------
# True puts every page behind the login screen. Leave False for a single
# user on a machine only they can reach.
REQUIRE_LOGIN=False
